# LLM Provider: "openai" or "openrouter"
# OpenRouter offers free models (no credit card required)
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# API Keys (configure the one matching LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/predicate_db
REDIS_URL=redis://localhost:6379/0

# Auth
REQUIRE_AUTH=false
