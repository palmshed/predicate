# LLM Provider: "openai" or "openrouter"
# OpenRouter offers free models (no credit card required)
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# API Keys (configure the one matching LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database
DATABASE_URL=postgresql://predicate_writer:password@localhost:5432/predicate_db
DATABASE_READONLY_URL=postgresql://predicate_reader:password@localhost:5432/predicate_db
REDIS_URL=redis://localhost:6379/0

# Auth
REQUIRE_AUTH=false

# Security
CSRF_SECRET_KEY=generate_with_python_-c_"import_secrets;print(secrets.token_hex(32))"
MAX_PROMPT_LENGTH=2000
QUERY_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
